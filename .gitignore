node_modules/
.next/
dist/
.env*
!.env.example
.vercel/
*.tsbuildinfo
test-results/
playwright-report/
supabase/.temp/

# Clash Display is downloaded from the foundry for our own sites at build time.
apps/*/public/fonts/clash-display.woff2
apps/marketing/public/portal-preview/fonts/clash-display.woff2

# Ignore previous locally cached brand font files as well.
apps/*/public/fonts/cabinet-grotesk.woff2
apps/marketing/public/portal-preview/fonts/cabinet-grotesk.woff2

# General Sans is obtained unmodified from Fontshare at build time.
apps/*/public/fonts/general-sans.woff2
apps/marketing/public/portal-preview/fonts/general-sans.woff2

# Locally bundled OFL masters are copied from shared/fonts at build time.
apps/*/public/fonts/schibsted-grotesk.woff2
apps/*/public/fonts/schibsted-grotesk-LICENSE.txt
apps/marketing/public/portal-preview/fonts/schibsted-grotesk.woff2
apps/marketing/public/portal-preview/fonts/schibsted-grotesk-LICENSE.txt
apps/*/public/fonts/archivo.woff2
apps/*/public/fonts/archivo-LICENSE.txt
apps/marketing/public/portal-preview/fonts/archivo.woff2
apps/marketing/public/portal-preview/fonts/archivo-LICENSE.txt
